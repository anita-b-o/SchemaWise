{
  "name": "@schemawise/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "node-pg-migrate --migrations-dir migrations up",
    "db:rollback": "node-pg-migrate --migrations-dir migrations down",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0"
  }
}
