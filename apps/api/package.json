{
  "name": "@schemawise/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration --maxWorkers=1",
    "bench:auth": "npm run build && node bench/auth-password.mjs",
    "db:migrate": "node-pg-migrate --migrations-dir migrations up",
    "db:rollback": "node-pg-migrate --migrations-dir migrations down",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0"
  }
}
